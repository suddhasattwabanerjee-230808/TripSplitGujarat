# Remember to never publicly share your RELEASE keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# The debug keystore is intentionally committed (app/debug.keystore) so local
# and CI builds share one signing identity — its SHA-1 is what's registered
# with the Google Maps API key restriction. It is not used for production
# release signing and its password is the public, well-known Android default.
!app/debug.keystore
# The release keystore is NOT committed (the repo is public): CI writes it
# from the RELEASE_KEYSTORE_BASE64 secret (see app/build.gradle.kts).
